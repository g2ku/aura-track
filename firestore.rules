rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Публичные данные — только чтение для всех
    match /public/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Данные пользователей — чтение/запись для авторизованных
    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      allow update: if request.auth != null;
      allow delete: if false;
    }

    // Настройки — чтение для авторизованных, запись для авторизованных
    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // Рабочие данные — только серверный доступ (через Admin SDK)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
