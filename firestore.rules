rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {
    // Публичные данные — только чтение для всех
    match /public/{document} {
      allow read: if true;
      allow write: if false;
    }

    // Рабочие данные — только серверный доступ (через Admin SDK)
    // Клиентский доступ запрещён — все операции через серверные функции
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
