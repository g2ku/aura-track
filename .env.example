# Poster POS API token
# Get from: Poster CRM > Settings > API > Tokens
# Format: {account_id}:{token_secret}
VITE_POSTER_TOKEN=

# Firebase config (auto-filled in production via Vercel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
