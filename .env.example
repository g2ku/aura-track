# Poster POS API token (server-side only — не попадает в клиентский бандл)
# Get from: Poster CRM > Settings > API > Tokens
# Format: {account_id}:{token_secret}
VITE_POSTER_TOKEN=

# Firebase config (auto-filled in production via Vercel)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Telegram-бот накладных ───────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Произвольная строка — ею Telegram подписывает вебхук (защита от подделок)
TELEGRAM_WEBHOOK_SECRET=
# JSON сервисного аккаунта Firebase одной строкой (для записи в Firestore)
FIREBASE_SERVICE_ACCOUNT=
# Секрет для Vercel Cron (задаётся автоматически на Vercel)
CRON_SECRET=
